# Base URL used in metadata, sitemap, and JSON-LD (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://www.intellistack.io

# Newsletter provider (wire up in app/actions/newsletter.ts)
ESP_API_KEY=

# Contact form email delivery (wire up in app/actions/contact.ts)
RESEND_API_KEY=

# Analytics (optional)
NEXT_PUBLIC_GA_ID=

# Google Sheets — admin affiliate database only (not used on public site)
# Create a service account in Google Cloud, enable Google Sheets API, share your sheet with the service account email as Editor.
GOOGLE_SHEETS_AFFILIATE_ID=12OjCVYm9EO0C4SfQ_x9vkkxEoGGnt4GTGjFAIoMS2y0
GOOGLE_SHEETS_AFFILIATE_TAB=Affiliate Tools
# Recommended: save your downloaded key as google-service-account.json in the project root
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=google-service-account.json
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Or paste the full service account JSON as a single line:
# GOOGLE_SERVICE_ACCOUNT_JSON=
