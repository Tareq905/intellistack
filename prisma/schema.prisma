generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// -----------------------------------------------------------------------------
// Auth & Users
// -----------------------------------------------------------------------------

model User {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid // Matches Supabase auth.users.id
  email     String   @unique
  role      UserRole @default(EDITOR)
  profile   Profile?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Profile {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @unique @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName  String?
  avatarUrl String?
  bio       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("profiles")
}

enum UserRole {
  ADMIN
  EDITOR
}

// -----------------------------------------------------------------------------
// AI Tools CMS
// -----------------------------------------------------------------------------

model Category {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  slug        String   @unique
  description String?
  icon        String?
  tools       Tool[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("categories")
}

model Tool {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  slug             String        @unique
  logoUrl          String?
  coverImageUrl    String?
  categoryId       String        @db.Uuid
  category         Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  shortDescription String
  fullReview       String        @db.Text // Rich Text/MDX
  rating           Decimal       @db.Decimal(3, 1)
  pricingModel     PricingModel
  isFree           Boolean       @default(false)
  officialWebsite  String?
  affiliateUrl     String?
  published        Boolean       @default(false)
  featured         Boolean       @default(false)
  seoTitle         String?
  metaDescription  String?
  openGraphImage   String?
  features         ToolFeature[]
  pros             ToolPro[]
  cons             ToolCon[]
  faqs             ToolFaq[]
  tags             String[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  // For comparisons
  comparisonsAsA Comparison[] @relation("ToolA")
  comparisonsAsB Comparison[] @relation("ToolB")

  @@map("tools")
}

enum PricingModel {
  FREE
  FREEMIUM
  PAID
  ENTERPRISE
}

model ToolFeature {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  toolId      String   @db.Uuid
  tool        Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)
  title       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("tool_features")
}

model ToolPro {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  toolId    String   @db.Uuid
  tool      Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tool_pros")
}

model ToolCon {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  toolId    String   @db.Uuid
  tool      Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tool_cons")
}

model ToolFaq {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  toolId    String   @db.Uuid
  tool      Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)
  question  String
  answer    String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tool_faqs")
}

// -----------------------------------------------------------------------------
// Comparisons CMS
// -----------------------------------------------------------------------------

model Comparison {
  id         String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug       String              @unique
  toolAId    String              @db.Uuid
  toolA      Tool                @relation("ToolA", fields: [toolAId], references: [id], onDelete: Restrict)
  toolBId    String              @db.Uuid
  toolB      Tool                @relation("ToolB", fields: [toolBId], references: [id], onDelete: Restrict)
  winnerId   String?             @db.Uuid // Nullable if tie
  summary    String              @db.Text
  content    String              @db.Text // Rich Text/MDX
  sections   ComparisonSection[]
  faqs       String?             @db.Text // JSON or Text
  published  Boolean             @default(false)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@map("comparisons")
}

model ComparisonSection {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  comparisonId String     @db.Uuid
  comparison   Comparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)
  title        String
  content      String     @db.Text
  winnerId     String?    @db.Uuid // Which tool won this specific category
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("comparison_sections")
}

// -----------------------------------------------------------------------------
// Blog CMS
// -----------------------------------------------------------------------------

model Post {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title           String
  slug            String    @unique
  excerpt         String?   @db.Text
  content         String    @db.Text // Rich text
  coverImage      String?
  authorId        String    @db.Uuid
  status          PostStatus @default(DRAFT)
  publishedAt     DateTime?
  seoTitle        String?
  metaDescription String?
  postTags        PostTag[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("posts")
}

enum PostStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
}

model Tag {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  slug      String    @unique
  postTags  PostTag[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("tags")
}

model PostTag {
  postId String @db.Uuid
  tagId  String @db.Uuid
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@map("post_tags")
}

// -----------------------------------------------------------------------------
// Newsletter & Media & Affiliates
// -----------------------------------------------------------------------------

model NewsletterSubscriber {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String   @unique
  status    SubStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("newsletter_subscribers")
}

enum SubStatus {
  ACTIVE
  UNSUBSCRIBED
}

model MediaFile {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fileName  String
  url       String
  mimeType  String
  size      Int
  uploadedBy String? @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("media_files")
}

model AffiliateLink {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  platform    String
  toolName    String
  slug        String   @unique
  affiliateUrl String
  fallbackUrl String?
  status      AffiliateStatus @default(ACTIVE)
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("affiliate_links")
}

enum AffiliateStatus {
  ACTIVE
  INACTIVE
  PENDING
}

model AffiliateResearch {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  toolName          String
  officialWebsite   String?
  category          String?
  freePaid          String?
  startingPrice     String?
  affiliateProgram  String?
  affiliateUrl      String?
  affiliateNetwork  String?
  commission        String?
  cookieDuration    String?
  minimumPayout     String?
  pros              String?  @db.Text
  cons              String?  @db.Text
  notes             String?  @db.Text
  keyword           String?
  searchVolume      String?
  keywordDifficulty String?
  reviewStatus      String?
  comparisonStatus  String?
  bestToolsStatus   String?
  researchDate      String?
  lastUpdated       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("affiliate_research")
}

// -----------------------------------------------------------------------------
// Settings & Logs
// -----------------------------------------------------------------------------

model SeoSetting {
  id          String   @id @default("global") // Single row pattern
  title       String?
  description String?  @db.Text
  canonical   String?
  openGraph   String?  @db.Text // JSON
  twitter     String?  @db.Text // JSON
  robots      String?
  sitemap     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("seo_settings")
}

model SiteSetting {
  id                 String   @id @default("global")
  siteName           String?
  logoUrl            String?
  faviconUrl         String?
  socialLinks        String?  @db.Text // JSON
  footerText         String?  @db.Text
  analyticsIds       String?  @db.Text // JSON
  affiliateDisclosure String? @db.Text
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("site_settings")
}

model ActivityLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String?  @db.Uuid
  action    String
  entity    String
  entityId  String?
  details   String?  @db.Text // JSON
  createdAt DateTime @default(now())

  @@map("activity_logs")
}
